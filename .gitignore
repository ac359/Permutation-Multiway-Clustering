# =========================================================================
# .gitignore for the mwperm R package
#
# The repository contains only the installable package: R/, man/, data/,
# data-raw/, inst/, tests/, vignettes/, DESCRIPTION, NAMESPACE, NEWS.md,
# README.md, LICENSE and .github/. Everything below is build output,
# machine-local state, or local working material.
# =========================================================================

# ----- local working material, not part of the package -----
private/

# ----- R build artifacts -----
*.tar.gz
*.Rcheck/
..Rcheck/
/*.Rout
src/*.o
src/*.so
src/*.dll
inst/doc/

# generated replication artifacts (the scripts + expected/ are tracked)
inst/replication/out/
inst/replication/cache/

# ----- R / RStudio machine-local state -----
.Rhistory
.Rapp.history
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# ----- vignette / knitr build outputs -----
vignettes/*.html
vignettes/*.R
vignettes/*_cache/
vignettes/*_files/

# ----- OS / editor cruft -----
.DS_Store
Thumbs.db
*~
.idea/
.vscode/
