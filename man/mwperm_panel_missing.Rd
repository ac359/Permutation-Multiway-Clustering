                       trade_panel$year == max(trade_panel$year)), ]
fit5 <- with(tp5, mwperm_panel_missing(y = log_trade, d = fta,
                                       x = cbind(log_gdp_i, log_gdp_j),
                                       row = importer, col = exporter,
