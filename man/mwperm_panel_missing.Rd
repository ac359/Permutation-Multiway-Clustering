thin <- sample(unique(pair), 20)
tp <- tp[!(pair \%in\% thin & tp$year > min(tp$year)), ]
fit <- with(tp, mwperm_panel_missing(y = log_trade, d = fta,
                                     x = cbind(log_gdp_i, log_gdp_j),
